# ---- Core ----
# Postgres connection. On Vercel, the Neon integration provides POSTGRES_URL automatically.
# For any other Postgres (Supabase, RDS, local), standard postgresql:// URLs work too.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# POSTGRES_URL=postgres://user:pass@ep-example.ap-southeast-1.aws.neon.tech/db?sslmode=require

# Public site URL — used for canonical URLs, OpenGraph, sitemap and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Store identity (drives legal pages, contact points, emails) ----
STORE_CONTACT_EMAIL=support@beevo.in
STORE_LEGAL_NAME=Beevo Retail
# STORE_ADDRESS=123, Example Business Park, Bengaluru, Karnataka 560001
EMAIL_FROM=Beevo <orders@beevo.in>

# ---- Admin (/admin) — never commit real values ----
ADMIN_PASSWORD=change-me-strong-password
ADMIN_SESSION_SECRET=generate-a-long-random-hex-string

# ---- Optional integrations (store works without them) ----
# Online payments (UPI/cards/netbanking). Without keys, checkout is COD-only.
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...

# Transactional email delivery via Resend. Without a key, every email is
# still recorded in the email_logs table with delivery = "skipped".
# RESEND_API_KEY=re_...

# Contact-form delivery via Web3Forms (https://web3forms.com). Every message
# is also stored in the contact_messages table, so this is additive. The key
# stays server-side; browser fallback delivery is used automatically on
# Web3Forms free plans.
# WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
