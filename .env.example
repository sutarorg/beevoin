# ---------------------------------------------------------------------------
# Beevo — environment variables
#
# Copy to .env.local for local development, and paste the same keys into
# Vercel → Project → Settings → Environment Variables for production.
# Never commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# ---- 1. Database (required) ------------------------------------------------
# Any PostgreSQL 14+ connection string. Neon, Supabase Postgres, RDS and a
# local server all work. This is where every order, payment and log lives.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/beevo

# Optional. The Vercel Postgres / Neon integration sets POSTGRES_URL for you;
# when it is present on Vercel it wins over DATABASE_URL and the serverless
# Neon driver is used automatically. Leave it unset elsewhere.
# POSTGRES_URL=postgres://user:pass@ep-example.ap-south-1.aws.neon.tech/beevo?sslmode=require

# ---- 2. Site (required) ----------------------------------------------------
# Public origin, no trailing slash. Used for canonical URLs, OpenGraph tags,
# the sitemap, and the order links inside emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- 3. Supabase Auth (required for /admin) --------------------------------
# Supabase is used ONLY to authenticate staff. No store data is kept there.
# Dashboard → Project Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# ---- 4. Razorpay (optional; without it checkout is Cash on Delivery only) ---
# Test keys start with rzp_test_, live keys with rzp_live_.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret you choose in Razorpay → Settings → Webhooks.
# Required for /api/webhooks/razorpay to accept anything at all.
# RAZORPAY_WEBHOOK_SECRET=a-long-random-string-you-choose

# ---- 5. Resend email (optional; store works without it) --------------------
# Without a key every email is still recorded in email_logs with
# delivery = "skipped", so nothing is silently lost.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=orders@yourdomain.com
# RESEND_FROM_NAME=Beevo
# Where new-order, contact-message and low-stock alerts are sent. This value
# can also be changed at runtime in /admin/settings.
# ADMIN_NOTIFICATION_EMAIL=owner@yourdomain.com

# ---- 6. Store identity fallbacks (optional) --------------------------------
# These are only defaults for a fresh database — /admin/settings overrides
# them once the store is running.
# STORE_LEGAL_NAME=Beevo Retail
# STORE_CONTACT_EMAIL=support@beevo.in
# STORE_ADDRESS=12 Example Business Park, Pune, Maharashtra 411001

# ---- 7. One-off script inputs (never needed at runtime) --------------------
# npm run db:seed — opening stock for the first product row.
# INITIAL_STOCK=25
# npm run admin:bootstrap — alternative to the --email / --supabase-id flags.
# BOOTSTRAP_ADMIN_EMAIL=owner@yourdomain.com
# BOOTSTRAP_ADMIN_SUPABASE_ID=00000000-0000-0000-0000-000000000000

# ---- 8. Tests --------------------------------------------------------------
# npm test truncates every table in this database before each test file.
# Point it at a throwaway database — NEVER at production.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/beevo_test
