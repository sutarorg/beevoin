##############################################################################
# Beevo — environment variables
#
# Copy to `.env.local` for local development:
#     cp .env.example .env.local
#
# Never commit `.env.local`. Every variable below is used by code in this
# repository — there are no leftovers, and nothing here is optional unless it
# says so.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle. Everything else
# stays on the server. Never add a secret with a NEXT_PUBLIC_ prefix.
##############################################################################

# ---------------------------------------------------------------------------
# Database — REQUIRED
# PostgreSQL connection string. On Vercel Postgres / Neon / Supabase Postgres,
# use the POOLED connection string and keep `sslmode=require`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/beevo

# ---------------------------------------------------------------------------
# Store identity — REQUIRED
# NEXT_PUBLIC_SITE_URL must be the canonical public origin, with no trailing
# slash. It is used for canonical URLs, sitemap, Open Graph and email links.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STORE_CONTACT_EMAIL=support@yourstore.in
STORE_LEGAL_NAME=Your Registered Business Name
STORE_ADDRESS=Street, City, State PIN, India

# ---------------------------------------------------------------------------
# Supabase Auth — REQUIRED for the /admin panel
# Identity only. No customer or order data is stored in Supabase.
# Find both values in your Supabase project: Connect → App frameworks,
# or Project Settings → API Keys.
# The publishable key (sb_publishable_...) is safe in the browser.
# There is deliberately NO SUPABASE_SECRET_KEY: this app never needs one.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Razorpay — REQUIRED for online payments
# Dashboard → Account & Settings → API Keys.
# Use rzp_test_* keys until you are ready to take real money.
# RAZORPAY_KEY_SECRET must never appear in client code.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret you choose when creating the webhook in
# Dashboard → Account & Settings → Webhooks. Without it the webhook endpoint
# returns 503 and payments are confirmed only by the browser callback.
RAZORPAY_WEBHOOK_SECRET=a-long-random-string-you-choose

# ---------------------------------------------------------------------------
# Cash on Delivery SMS verification — REQUIRED before COD can be enabled
#
# Beevo uses Twilio Verify for OTP delivery/checking. These values stay on the
# server; do NOT prefix them with NEXT_PUBLIC_. Create a Verify Service in
# Twilio, then copy the Account SID, Auth Token and Verify Service SID here.
# Generate COD_OTP_TOKEN_SECRET with: openssl rand -base64 48
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COD_OTP_TOKEN_SECRET=replace-with-a-random-32-plus-character-secret

# ---------------------------------------------------------------------------
# Resend — REQUIRED for transactional email
# RESEND_FROM_EMAIL must be on a domain you have verified in Resend.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=orders@yourstore.in
RESEND_FROM_NAME=Beevo

# Internal alerts: contact-form messages, low-stock and payment-failure
# notices. Can be changed later from /admin/settings.
ADMIN_NOTIFICATION_EMAIL=ops@yourstore.in
